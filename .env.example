# Copy this file to .env.local and fill in real values (do NOT commit secrets)
# Service account JSON may be provided as the full JSON string in SERVICE_ACCOUNT_JSON
# or place a service account JSON file at serviceAccountKey.json in the project root (gitignored).

FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# Option A: provide full JSON here (not recommended for committed files)
#SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option B: place serviceAccountKey.json at project root (gitignored)
# See README for steps
