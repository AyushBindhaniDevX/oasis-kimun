{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "accessControl": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "applications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "activeSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "oc": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved')",
      "notifications": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
        }
      }
    },

    "chat": {
      "rooms": {
        "$roomId": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved')",
          ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved')"
        }
      },
      "messages": {
        "$roomId": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved')",
          "$messageId": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved') && (!data.exists() ? newData.child('senderId').val() === auth.uid : newData.child('senderId').val() === data.child('senderId').val())"
          }
        }
      },
      "typing": {
        "$roomId": {
          "$typingUid": {
            ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('applications').child(auth.uid).child('status').val() === 'approved')",
            ".write": "auth != null && auth.uid === $typingUid"
          }
        }
      }
    },

    "messages": {
      "$applicationUid": {
        ".read": "auth != null && (auth.uid === $applicationUid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $applicationUid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "interviewSlots": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
